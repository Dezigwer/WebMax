<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Эти настройки упакуют всё в один EXE -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="ico.ico" />
    <EmbeddedResource Include="back.png" />
    <EmbeddedResource Include="forward.png" />
    <EmbeddedResource Include="refresh.png" />
    <EmbeddedResource Include="home.png" />
    <EmbeddedResource Include="minimize.png" />
    <EmbeddedResource Include="close.png" />
  </ItemGroup>
</Project>
